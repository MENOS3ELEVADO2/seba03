---
// Extraemos las propiedades 'titulo' y 'descripcion' del objeto Astro.props.
// Esto permite usar esas variables directamente en el HTML.
const { titulo, descripcion } = Astro.props;
---

<!-- Contenedor principal con clase 'token' -->
<div class="token">
  <!-- Título dinámico que se muestra en un encabezado h2 -->
  <h2>{titulo}</h2>

  <!-- Descripción dinámica que se muestra en un párrafo -->
  <p>{descripcion}</p>

  <!-- Botón interactivo (puedes agregarle funcionalidad con JS si lo necesitas) -->
  <button>Haz clic aquí</button>
</div>
