---
import "../styles/fondo.css";
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Portafolio</title>
    <!-- Aquí puedes agregar más etiquetas meta, links a fuentes, etc. -->
  </head>

  <body>
    <!-- Encabezado del sitio -->
    <header>
      <h1 id="bienvenida" class="pixel-text"></h1>
    </header>
  
    <!-- Contenido principal de la página -->
    <main>
      <slot /> <!-- Aquí se inserta el contenido de cada página -->
    </main>
  
    <!-- Pie de página -->
    <footer>
      <p>&copy; 2025 Sebastian Vejar</p>
    </footer>
  
<script>
  // Texto que se va a mostrar con efecto de escritura
  const texto = "Bienvenido a mi portafolio";

  // Se obtiene el elemento HTML con el id "bienvenida"
  const elemento = document.getElementById("bienvenida");

  // Variable para llevar el control del índice actual del texto
  let i = 0;

  // Función que escribe el texto letra por letra
  function escribir() {
    // Verifica si aún quedan letras por escribir
    if (i < texto.length) {
      // Agrega la letra actual al contenido del elemento si existe
      if (elemento) {
        elemento.textContent += texto.charAt(i);
      }
      

      // Avanza al siguiente carácter
      i++;

      // Llama nuevamente a la función después de 100 milisegundos
      // Esto crea el efecto de "máquina de escribir"
      setTimeout(escribir, 100);
    }
  }

  // Inicia el efecto de escritura al cargar el script
  escribir();
</script>
  </body>
</html>