---
import "../styles/fondo.css";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import "../styles/card.css";
---

<Layout>
  <!-- Contenedor principal del blog -->
  <div class="blog-layout">

    <!-- Barra lateral -->
    <aside class="sidebar">
      <!-- Imagen de perfil -->
      <img src="../assets/mi-perfil.jpg" alt="Foto de perfil" class="perfil" />
      
      <!-- Botones -->
      <div class="botones">
        <button class="win95-button" data-target="inicio">Inicio</button>
        <button class="win95-button" data-target="sobre-mi">Sobre mí</button>
        <button class="win95-button" data-target="proyectos">Proyectos</button>
        <button class="win95-button" data-target="contacto">Contacto</button>
      </div>
    </aside>

    <!-- Contenido -->
    <section>
      
      <!-- Card Inicio -->
      <div id="inicio" class="card visible">
        <h1>Bienvenido a mi blog</h1>
        <p>Aquí puedes ver mis publicaciones y proyectos destacados.</p>
      </div>

      <!-- Card Sobre mí -->
      <div id="sobre-mi" class="card oculto">
        <h2>Sobre mí</h2>
        <p>Un poco sobre mí...</p>
      </div>

      <!-- Card Proyectos -->
      <div id="proyectos" class="card oculto">
        <h2>Proyectos</h2>
        <p>Estos son mis proyectos destacados.</p>
      </div>

      <!-- Card Contacto -->
      <div id="contacto" class="card oculto">
        <h2>Contacto</h2>
        <p>Puedes escribirme aquí.</p>
      </div>

    </section>
  </div>

  <!-- Script -->
  <script>
    const botones = document.querySelectorAll(".win95-button");
    const tarjetas = document.querySelectorAll(".card");

    botones.forEach(boton => {
      boton.addEventListener("click", () => {
        const target = boton.getAttribute("data-target");

        // Ocultar todas las tarjetas
        tarjetas.forEach(t => t.classList.add("oculto"));
        tarjetas.forEach(t => t.classList.remove("visible"));


        // Mostrar la tarjeta activa
        const activa = document.getElementById(target);
        if (activa) {
          activa.classList.remove("oculto");
          activa.classList.add("visible");
        }
      });
    });
  </script>
</Layout>
