---
import "../styles/fondo.css";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Token from "../components/token.astro";
import "../styles/card.css";

---

<!-- Este componente Layout envuelve toda la página.
     Se importa desde la carpeta /layouts y define la estructura base (head, body, etc.) -->
<Layout>

  <!-- Contenedor principal del blog con diseño en flexbox -->
  <div class="blog-layout">

    <!-- Barra lateral que contiene la imagen de perfil y los botones de navegación -->
    <aside class="sidebar">

      <!-- Imagen de perfil del autor del blog -->
      <img src="../assets/mi-perfil.jpg" alt="Foto de perfil" class="perfil" />
      
      <!-- Contenedor de botones de navegación -->
      <div class="botones">
        <button class="win95-button">Inicio</button>
        <button class="win95-button">Sobre mí</button>
        <button class="win95-button">Proyectos</button>
        <button class="win95-button">Contacto</button>
      </div>

    </aside>

    <!-- Sección principal del contenido del blog -->
    <section class="contenido">
      <h1>Bienvenido a mi blog</h1> <!-- Título principal -->
      <p>Aquí puedes ver mis publicaciones y proyectos destacados.</p> <!-- Descripción introductoria -->

      <!-- Aquí puedes agregar más contenido del blog, como artículos, tarjetas, etc. -->
    
      <div id="inicio" class="card visible">
        <h2>inicio</h2>
        <p>Inicio</p>
        <!-- Contenedor para las tarjetas de contenido -->
      </div>

      <div id="sobre-mi" class="card oculto">
        <h2>Sobre mí</h2>
        <p>sobre mi</p>
        <!-- Contenedor para las tarjetas de contenido -->
      
      </div>

      <div id="proyectos" class="card oculto">
        <h2>Proyectos</h2>
        <p>Proyectos</p>
        <!-- Contenedor para las tarjetas de contenido -->
      </div>

      <div id="contacto" class="card oculto">
        <h2>Contacto</h2>
        <p>contacto</p>
        <!-- Contenedor para las tarjetas de contenido -->
      </div>

    </section>
  </div>



  <script>
  const botones = document.querySelectorAll(".win95-button");
  const tarjetas = document.querySelectorAll(".card");

  botones.forEach(boton => {
    boton.addEventListener("click", () => {
      const texto = boton.textContent.toLowerCase().replace(" ", "");

      tarjetas.forEach(t => t.classList.add("oculto"));
      const activa = document.getElementById(texto);
      if (activa) {
        activa.classList.remove("oculto");
        activa.classList.add("visible");
      }
    });
  });
</script>

</Layout>
