---
import "../styles/fondo.css";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import "../styles/card.css";
---

<Layout>
  <!-- Contenedor principal del blog -->
  <div class="blog-layout">

    <!-- Barra lateral -->
    <aside class="sidebar">
      <!-- Imagen de perfil -->
      <img src="../assets/mi-perfil.jpg" alt="Foto de perfil" class="perfil" />
      
      <!-- Botones -->
      <div class="botones">
        <button class="win95-button" data-target="sobre-mi">Sobre mí</button>
        <button class="win95-button" data-target="proyectos">Proyectos</button>
        <button class="win95-button" data-target="contacto">Contacto</button>
      </div>
    </aside>

    <!-- Contenido -->
    <section>      

      <!-- Card Sobre mí -->
      <div id="sobre-mi" class="card oculto">
        <h2>Sobre mí</h2>
        <p>Soy Sebastián Vejar, estudiante de Ingeniería en Informática.
         Me interesa especialmente el desarrollo de videojuegos,
         el análisis de datos y el aprendizaje automático (machine learning).
         Aunque recién estoy comenzando mi camino, tengo la motivación y
         las ganas de aportar y lograr grandes resultados trabajando en equipo.</p>
      </div>

      <!-- Card Proyectos -->
      <div id="proyectos" class="card oculto">
        <h2>Proyectos</h2>
        <p>Estos son mis proyectos destacados.</p>
      </div>

      <!-- Card Contacto -->
      <div id="contacto" class="card oculto">
        <h2>Contactame</h2>
        <p>Puedes ver y Escribirme en Linkedin: <a href="https://www.linkedin.com/in/sebastian-vejar-9a1353297" target="_blank">Mi Perfil de Linkedin</a></p>
        <p>Escribeme a mi Correo: <a href=https://mail.google.com/mail/?view=cm&fs=1&to=vejars42@gmail.com">vejars42@gmail.com</a></p>
        <p>Aquí puedes ver mi Trabajos y Escribirme Tambien en GitHub: <a href="https://github.com/MENOS3ELEVADO2" target="_blank">GitHub</a></p>
        <p>Teléfono: <a href="tel:+56 9 5986 0891">+56 9 5986 0891</a></p>
      </div>

    </section>
  </div>

  <!-- Script -->
<script>
  const botones = document.querySelectorAll(".win95-button");
  const tarjetas = document.querySelectorAll(".card");

  botones.forEach((boton) => {
    boton.addEventListener("click", () => {
      // 1) Leer el atributo de forma segura
      const target = boton.getAttribute("data-target");
      if (!target) return; // si falta, no hacemos nada

      // 2) Ocultar todo
      tarjetas.forEach((t) => {
        t.classList.add("oculto");
        t.classList.remove("visible");
      });

      // 3) Mostrar solo el card objetivo, si existe
      const activa = document.getElementById(target);
      if (!activa) return;

      activa.classList.remove("oculto");
      activa.classList.add("visible");
    });
  });
</script>

</Layout>
